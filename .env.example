# Skopiuj ten plik jako ".env" (cp .env.example .env) i uzupełnij wartości.
# Plik .env jest w .gitignore, NIE commituj go.

# --- Airflow ---
AIRFLOW_UID=50000
# Klucz Fernet; wygeneruj poleceniem:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Pakiety doinstalowywane przy starcie kontenerów Airflow
_PIP_ADDITIONAL_REQUIREMENTS=pandas sqlalchemy psycopg2-binary boto3 pyarrow

# --- AWS (użytkownik IAM z dostępem tylko do bucketu, patrz docs/iam-policy.json) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=kacper-retail-data-lake
S3_REGION_NAME=eu-north-1

# --- PostgreSQL z danymi (działa na hoście, poza docker-compose) ---
RETAIL_DB_USER=postgres
RETAIL_DB_PASSWORD=postgres
RETAIL_DB_HOST=host.docker.internal
RETAIL_DB_PORT=5433
RETAIL_DB_NAME=online_retail_db
